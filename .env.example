# Copy to .env and fill in. Never commit .env.

# Anthropic API key (plan, digest, forecast)
ANTHROPIC_API_KEY=

# Tavily search API key
TAVILY_API_KEY=

# Prophet Arena weekly key (pa_weekly_...), from the "Submit your forecasts" registration
ARENA_API_KEY=

# Models
CHEAP_MODEL=claude-haiku-5-5
FORECAST_MODEL=claude-opus-5-5
